*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
runs/

# Ultralytics pretrained base weights (yolov8n.pt / yolo26n.pt) are auto-downloaded
# into the CWD during local training/the smoke test. They are generic COCO base
# models, NOT our trained detector. Ignore all stray model binaries EXCEPT the
# ones we deliberately publish under weights/ via git-lfs.
*.pt
!weights/*.pt
*.onnx
!weights/*.onnx
