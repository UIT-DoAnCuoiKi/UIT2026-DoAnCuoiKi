.superpowers/

# secrets
.env

# local Python env
.venv/
__pycache__/
.ipynb_checkpoints/


# downloaded datasets (large, not committed) — anchored to repo root so
# nested package source dirs like src/ml/plate_detect/plate_detect/data/ stay tracked
/data/

# macOS
.DS_Store

# training results / large binaries (kept locally, not committed)
runs/
weights/
# ...nhưng src/ml/weights/ có quy tắc riêng ở dưới (chỉ *.pt bị loại, *.onnx nhỏ được giữ)
# nên phải gỡ ẩn cả thư mục này trước, không thì không "nhìn" được vào bên trong
!src/ml/weights/

# notebook run artifacts + kaggle log dumps
src/ml/plate_detection_pipeline/notebooks/klog*/
src/ml/plate_detection_pipeline/notebooks/kaggle_out/
src/ml/plate_detection_pipeline/notebooks/out13/
src/ml/plate_detection_pipeline/output/plate_det_results_20260812_2212

# downloaded datasets (large, not committed) — anchored to repo root only,
# so it doesn't also swallow src/ml/data/ (small committed class-list/split files)
/data/

# training checkpoints/weights (large; keep only small exported onnx if needed)
src/ml/checkpoints/
src/ml/weights/*.pt
# các bản onnx thí nghiệm (V0/V1/V2/seed...) giữ local để đối chiếu, không commit -
# chỉ file chính thức không có hậu tố (vd plate-ocr-crnn.onnx) mới được track
src/ml/weights/*-V*.onnx

# editor-local settings
.vscode/

# ad-hoc personal test photos of real vehicles (may show plates - personal data, not a tracked dataset)
testimage/
