% figures/uml-er.tikz — Sơ đồ ER các bảng trung tâm
% Nguồn: src/backend/app/models/{parking_session,plate_reading,payment,
%         price_rule,image_asset,shift,user}.py
\begin{tikzpicture}[
  font=\scriptsize,
  ttl/.style={font=\bfseries},
  attrblk/.style={font=\tiny, text=black!70, align=left, inner sep=1pt},
  ebox/.style={draw, fill=blue!8, rounded corners=2pt, inner sep=5pt},
  fk/.style={->, >=stealth, dashed, thick, color=black!60},
  rel/.style={->, >=stealth, thick, dotted},
  elab/.style={font=\tiny, fill=white, inner sep=1.5pt, text=black!75}
]
% --- Thực thể: tiêu đề + khối thuộc tính ---
\node[ttl] (session-t) at (0,0) {session};
\node[attrblk, below=3pt of session-t] (session-a) {%
  \underline{id}, uuid\\ plate\_hash, plate\_ciphertext\\ vehicle\_group, status\\
  entry\_time, exit\_time\\ fee\_amount, fee\_rule\_snapshot\\ match\_flag};

\node[ttl] (reading-t) at (-5.4,-4.6) {plate\_reading};
\node[attrblk, below=3pt of reading-t] (reading-a) {%
  \underline{id}, capture\_id, direction\\ plate\_hash, plate\_valid\\
  det\_conf, ocr\_conf, color\\ vehicle\_type, vehicle\_style\\ review\_state};

\node[ttl] (payment-t) at (5.4,-4.6) {payment};
\node[attrblk, below=3pt of payment-t] (payment-a) {%
  \underline{id}, session\_id (FK)\\ amount (VND), method\\
  kind, shift\_id (FK)\\ staff\_id (FK), paid\_at};

\node[ttl] (pricerule-t) at (0,-9.0) {price\_rule};
\node[attrblk, below=3pt of pricerule-t] (pricerule-a) {%
  \underline{id}, vehicle\_group\\ mode (flat | block)\\
  unit\_price, block\_minutes\\ grace\_minutes, daily\_cap};

\node[ttl] (asset-t) at (-5.4,-9.0) {image\_asset};
\node[attrblk, below=3pt of asset-t] (asset-a) {%
  \underline{id}, path, encrypted\\ sha256, direction\\ retention\_delete\_after};

\node[ttl] (shift-t) at (5.4,-9.0) {shift};
\node[attrblk, below=3pt of shift-t] (shift-a) {%
  \underline{id}, staff\_id (FK)\\ opened\_at, closed\_at\\ opening\_cash, status};

\node[ttl] (users-t) at (0,-13.2) {users};
\node[attrblk, below=3pt of users-t] (users-a) {%
  \underline{id}, username\\ password\_hash, role\\ active};

% --- Khung thực thể vẽ dưới nền để chữ nổi lên trên ---
\begin{scope}[on background layer]
  \node[ebox, fit=(session-t)(session-a)]     (session)   {};
  \node[ebox, fit=(reading-t)(reading-a)]     (reading)   {};
  \node[ebox, fit=(payment-t)(payment-a)]     (payment)   {};
  \node[ebox, fit=(pricerule-t)(pricerule-a)] (pricerule) {};
  \node[ebox, fit=(asset-t)(asset-a)]         (asset)     {};
  \node[ebox, fit=(shift-t)(shift-a)]         (shift)     {};
  \node[ebox, fit=(users-t)(users-a)]         (users)     {};
\end{scope}

% --- Quan hệ khóa ngoại (nhãn nền trắng, đi trong khoảng trống) ---
% session -> reading
\draw[fk] (session.west) to[out=180,in=90]
  node[elab,pos=0.55]{entry/exit\_reading\_id} (reading.north);
% session -> price_rule (quan hệ áp giá theo nhóm xe)
\draw[rel] (session.south) --
  node[elab]{vehicle\_group} (pricerule.north);
% session -> users (người tạo/đóng phiên), vòng phải price_rule
\draw[fk] (session.east) -- ++(1.5,0) |-
  node[elab,pos=0.28]{created\_by, closed\_by} (users.east);
% payment -> session
\draw[fk] (payment.west) --
  node[elab]{session\_id} (payment.west -| session.east);
% payment -> shift
\draw[fk] (payment.south) --
  node[elab]{shift\_id} (shift.north);
% reading -> image_asset
\draw[fk] (reading.south) --
  node[elab]{image/crop\_asset\_id} (asset.north);
% shift -> users (nhân viên mở ca)
\draw[fk] (shift.south) |-
  node[elab,pos=0.75]{staff\_id} (users.east);
% payment -> users (nhân viên thu tiền), vòng phải rồi xuống đáy
\draw[fk] (payment.east) -- ++(1.2,0) |-
  node[elab,pos=0.30]{staff\_id} (users.south);
\end{tikzpicture}
