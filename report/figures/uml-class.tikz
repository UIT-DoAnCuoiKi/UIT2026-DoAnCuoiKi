% figures/uml-class.tikz — Sơ đồ lớp runner và dịch vụ
% Nguồn: src/ml/pipeline/onnx_pipeline.py,
%         src/backend/app/services/inference.py,
%         src/backend/app/routers/captures.py
\begin{tikzpicture}[
  font=\scriptsize,
  cls/.style={draw, fill=blue!7, rounded corners=2pt,
              minimum width=4.2cm, minimum height=0.55cm, text centered},
  mtd/.style={font=\tiny, align=left, text=black!80},
  pkg/.style={draw, dashed, rounded corners=5pt, inner sep=10pt, fill=gray!4},
  arr/.style={->, >=stealth, thick},
  dep/.style={->, >=stealth, dashed, thick}
]
% Package src/ml
\node[pkg, minimum width=5.4cm, minimum height=7.0cm,
      label=above:{\scriptsize \texttt{src/ml/pipeline/}}]
      (mlpkg) at (0, 0) {};

\node[cls] (pipeline) at (0,  2.2) {\texttt{OnnxAlprPipeline}};
\node[mtd, below=0.08cm of pipeline] {
  + \_\_init\_\_(plate\_weights, ocr\_onnx,\\
  \hspace{0.6cm}style\_onnx, device: str)\\
  + run(image\_bgr) : dict
};

\node[cls] (ocr)      at (0,  0.2) {\texttt{\_OnnxCRNNRecognizer}};
\node[mtd, below=0.08cm of ocr] {
  + recognize(image\_bgr) : (str, float)
};

\node[cls] (detector) at (0, -1.6) {\texttt{PlateDetector}};
\node[mtd, below=0.08cm of detector] {
  + detect(image\_bgr) : list[Det]
};

% Package src/backend
\node[pkg, minimum width=5.4cm, minimum height=7.0cm,
      label=above:{\scriptsize \texttt{src/backend/app/}},
      right=3.0cm of mlpkg]
      (bepkg) {};

\node[cls] (engine)  at (9.8,  2.2) {\texttt{InferenceEngine}};
\node[mtd, below=0.08cm of engine] {
  + infer(image\_bytes) : PipelinePayload
};

\node[cls] (ingest)  at (9.8,  0.2) {\texttt{capture\_ingest}};
\node[mtd, below=0.08cm of ingest] {
  + ingest\_reading(...) : PlateReading\\
  + build\_capture\_response(...)
};

\node[cls] (router)  at (9.8, -1.6) {\texttt{captures router}};
\node[mtd, below=0.08cm of router] {
  POST /captures/infer\\
  POST /captures
};

% Quan hệ trong src/ml
\draw[arr] (pipeline.south) to[bend right=15] (ocr.north);
\draw[arr] (pipeline.south) to[bend right=15] (detector.north);

% Quan hệ giữa hai package
\draw[dep] (engine.west)
  to node[above, font=\tiny]{sử dụng in-process}
  (pipeline.east |- engine.west);

% Quan hệ trong src/backend
\draw[arr] (router.north) to (engine.south);
\draw[arr] (router.north) to[bend left=15] (ingest.south);
\end{tikzpicture}
