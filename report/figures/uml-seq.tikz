% figures/uml-seq.tikz — Sơ đồ tuần tự: một lượt xe vào-ra
% Nguồn: src/backend/app/routers/captures.py, sessions.py
\begin{tikzpicture}[
  font=\scriptsize,
  life/.style={draw, fill=gray!10, minimum width=1.6cm, minimum height=0.5cm, text centered},
  msg/.style={->, >=stealth, thick},
  ret/.style={->, >=stealth, dashed},
  note/.style={font=\tiny, fill=yellow!20, draw, rounded corners=2pt, inner sep=2pt}
]
% Tiêu đề lifeline
\node[life] (cam)    at (0,    0) {Camera/\\ Browser};
\node[life] (be)     at (3.8,  0) {Backend\\ FastAPI};
\node[life] (runner) at (7.3,  0) {Onnx\\ Pipeline};
\node[life] (db)     at (10.8, 0) {PostgreSQL};

% Đường sống
\foreach \x in {0, 3.8, 7.3, 10.8}
  \draw[dashed, gray] (\x, -0.3) to (\x, -10.8);

% Activation bar (backend)
\fill[gray!20] (3.6,-0.3) rectangle (4.0,-10.5);
% Activation bar (runner)
\fill[gray!20] (7.1,-1.1) rectangle (7.5,-2.2);
\fill[gray!20] (7.1,-5.8) rectangle (7.5,-6.5);

% === XE VÀO ===
\node[left, font=\tiny\itshape] at (-0.1, -0.8) {[Vào]};
\draw[msg] (0,-1.0) to node[above]{\texttt{POST /captures/infer}} (3.8,-1.0);
\draw[msg] (3.8,-1.3) to node[above]{infer(image)} (7.3,-1.3);
\draw[ret] (7.3,-2.0) to node[above]{payload dict} (3.8,-2.0);
\draw[msg] (3.8,-2.4) to node[above]{ingest\_reading()} (10.8,-2.4);
\draw[ret] (10.8,-2.7) to node[above]{reading\_id} (3.8,-2.7);
\draw[ret] (3.8,-3.0) to node[above]{CaptureResponse} (0,-3.0);

\draw[msg] (0,-3.6) to node[above]{\texttt{POST /sessions/entry}} (3.8,-3.6);
\node[note] at (6.0,-4.0) {kiểm tra trùng + blacklist};
\draw[msg] (3.8,-4.3) to node[above]{INSERT session (in\_lot)} (10.8,-4.3);
\draw[ret] (10.8,-4.6) to node[above]{session} (3.8,-4.6);
\draw[ret] (3.8,-4.9) to node[above]{SessionOut} (0,-4.9);

% === XE RA ===
\node[left, font=\tiny\itshape] at (-0.1, -5.5) {[Ra]};
\draw[msg] (0,-5.7) to node[above]{\texttt{POST /captures/infer}} (3.8,-5.7);
\draw[msg] (3.8,-5.9) to node[above]{infer} (7.3,-5.9);
\draw[ret] (7.3,-6.4) to node[above]{payload dict} (3.8,-6.4);
\draw[msg] (3.8,-6.7) to node[above]{ingest\_reading(dir=out)} (10.8,-6.7);
\draw[ret] (10.8,-7.0) to node[above]{reading\_id} (3.8,-7.0);
\draw[ret] (3.8,-7.3) to node[above]{CaptureResponse} (0,-7.3);

\draw[msg] (0,-7.8) to node[above]{\texttt{POST /sessions/exit}} (3.8,-7.8);
\node[note] at (6.0,-8.2) {find\_match() — exact/auto/suggest};
\draw[msg] (3.8,-8.5) to node[above]{compute\_fee() + UPDATE session} (10.8,-8.5);
\draw[ret] (10.8,-8.8) to node[above]{session (completed)} (3.8,-8.8);
\draw[ret] (3.8,-9.1) to node[above]{ExitResult} (0,-9.1);

% === THU TIỀN ===
\draw[msg] (0,-9.6) to node[above]{\texttt{POST /payments}} (3.8,-9.6);
\draw[msg] (3.8,-9.9) to node[above]{INSERT payment} (10.8,-9.9);
\draw[ret] (3.8,-10.2) to node[above]{PaymentOut} (0,-10.2);
\end{tikzpicture}
