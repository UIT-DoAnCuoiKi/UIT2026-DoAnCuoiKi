# Engine suy luận cho POST /captures/infer:
#   ml   = chạy model đã train ở src/ml (dùng cho demo/e2e thật, xem README)
#   fake = trả biển cứng 51F12345 (chỉ để dev/test không cần model)
INFERENCE_ENGINE=ml
# Đường dẫn model trong image backend (khớp COPY src/ml -> /app/src/ml)
